<body><main class="app"><header class="top"><div class="subtitle">Run, schedule and audit scripts across your devices.</div><div class="toolbar"><button data-edit onclick="newScript()">New script</button><button data-edit onclick="newFolder()">New folder</button><button data-edit onclick="uploadInput.click()">Upload</button><button data-edit id="renameBtn" onclick="renameItem()" disabled>Rename</button><button data-edit id="editBtn" onclick="editScript()" disabled>Edit</button><button data-edit id="deleteBtn" class="danger" onclick="deleteItem()" disabled>Delete</button><button id="downloadBtn" onclick="downloadScript()" disabled>Download</button><button onclick="refresh()">Refresh</button><input id="uploadInput" type="file" multiple hidden accept=".ps1,.bat,.bash,.sh"></div></header>
<section class="layout"><aside class="panel sidebar"><div class="panelhead"><h2>Scripts</h2><span class="badge" id="scriptCount">0</span></div><div style="padding:10px"><input class="search" id="scriptSearch" placeholder="Search scripts" oninput="drawTree()"></div><div class="tree" id="scriptTree"><div class="empty">Loading…</div></div></aside>
