function syncTheme(){try{var pd=parent.document,pt=pd.getElementById('theme-stylesheet'),lt=document.getElementById('scriptTaskTheme');if(pt&&pt.href&&lt.href!==pt.href)lt.href=pt.href;var mode=pd.documentElement.getAttribute('data-bs-theme');if(mode)document.documentElement.setAttribute('data-bs-theme',mode);var rs=parent.getComputedStyle(pd.documentElement),bs=parent.getComputedStyle(pd.body),root=document.documentElement,get=function(name,fallback){return themeColor(rs.getPropertyValue(name),fallback)},bg=get('--bs-body-bg',themeColor(bs.backgroundColor,'#f4f6f8')),fg=get('--bs-body-color',themeColor(bs.color,'#17202a')),panel=get('--bs-secondary-bg',bg),panel2=get('--bs-tertiary-bg',panel),brand=get('--bs-primary',get('--bs-link-color','#1261a0'));root.style.setProperty('--bg',bg);root.style.setProperty('--panel',panel);root.style.setProperty('--panel2',panel2);root.style.setProperty('--text',fg);root.style.setProperty('--muted',get('--bs-secondary-color',fg));root.style.setProperty('--line',get('--bs-border-color','rgba(128,128,128,.35)'));root.style.setProperty('--brand',brand);root.style.setProperty('--brand2',get('--bs-link-hover-color',brand));root.style.setProperty('--danger',get('--bs-danger','#b42318'));root.style.setProperty('--ok',get('--bs-success','#027a48'));root.style.setProperty('--warn',get('--bs-warning','#b54708'));root.style.setProperty('--on-brand',contrast('#fff',brand)>=contrast('#171717',brand)?'#fff':'#171717');root.style.colorScheme=mode||(luminance(bg)>.3?'light':'dark');document.body.style.fontFamily=bs.fontFamily}catch(x){}}
function watchTheme(){syncTheme();try{var pd=parent.document,update=function(){window.setTimeout(syncTheme,0)},pt=pd.getElementById('theme-stylesheet');new MutationObserver(update).observe(pd.documentElement,{attributes:true,attributeFilter:['class','style','data-bs-theme']});new MutationObserver(update).observe(pd.body,{attributes:true,attributeFilter:['class','style']});if(pt){new MutationObserver(update).observe(pt,{attributes:true,attributeFilter:['href']});pt.addEventListener('load',syncTheme)}document.getElementById('scriptTaskTheme').addEventListener('load',syncTheme)}catch(x){}}
function e(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function send(a,d,attempt){attempt=Number(attempt)||0;var server=null;try{server=window.parent&&window.parent.meshserver}catch(x){}if(!server||server.State!==2||typeof server.send!=='function'){if(attempt<60){setTimeout(function(){send(a,d,attempt+1)},250)}else{notice('MeshCentral connection is unavailable.',true)}return}try{server.send(Object.assign({action:'plugin',plugin:'scripttask',pluginaction:a},d||{}))}catch(x){if(attempt<60){setTimeout(function(){send(a,d,attempt+1)},250)}else{notice('Could not send the request to MeshCentral.',true)}}}function script(){return st.item&&st.item.type==='script'?st.item:null}function ns(){return Array.isArray(parent.nodes)?parent.nodes.filter(function(n){return n&&n.mtype===2}):[]}function ms(){return parent.meshes||{}}function nodeName(id){var n=ns().find(function(x){return x._id===id});return n?n.name:id}function scriptName(id){var s=st.data.tree.find(function(x){return String(x._id)===String(id)});return s?s.name:id}
function notice(m,bad){var x=document.getElementById('toast');x.textContent=m;x.className='toast'+(bad?' error':'');x.style.display='block';clearTimeout(x.t);x.t=setTimeout(function(){x.style.display='none'},4500)}function refresh(){send('loadDashboard')}window.scriptTaskRefresh=refresh;window.scriptTaskReceive=function(t,x){if(t==='dashboard'&&x.data){st.data=x.data;var id=st.item&&String(st.item._id);st.item=st.data.tree.find(function(i){return String(i._id)===id})||null;draw()}else if(t==='script'&&x.script){editor(x.script)}else if(t==='operation'){notice(x.message||'Done.',!x.ok);if(x.ok){closeModal();setTimeout(refresh,150)}}};
function tab(v){st.view=v;document.querySelectorAll('.tab').forEach(function(x){x.classList.toggle('active',x.dataset.tab===v)});drawView()}function draw(){drawTree();drawHead();document.querySelectorAll('[data-edit]').forEach(function(x){x.classList.toggle('hidden',(st.data.permissions||{}).edit===false)});drawView()}
function drawTree(){var q=(document.getElementById('scriptSearch').value||'').toLowerCase(),h='';(st.data.tree||[]).forEach(function(i){if(q&&((i.name||'')+' '+(i.path||'')).toLowerCase().indexOf(q)<0)return;var d=(String(i.path||'').match(/\//g)||[]).length+(i.type==='script'?1:0),on=st.item&&String(st.item._id)===String(i._id);h+='<button class="treeitem '+(on?'active':'')+'" style="padding-left:'+(8+d*16)+'px" onclick="pick(\''+e(i._id)+'\')" title="'+e(i.path)+'"><span>'+(i.type==='folder'?'📁':'📄')+'</span><span class="name">'+e(i.name)+'</span>'+(i.type==='script'?'<span class="badge">'+e(i.filetype)+'</span>':'')+'</button>'});document.getElementById('scriptTree').innerHTML=h||'<div class="empty">No scripts found.</div>';document.getElementById('scriptCount').textContent=(st.data.tree||[]).filter(function(i){return i.type==='script'}).length}function pick(id){st.item=st.data.tree.find(function(i){return String(i._id)===String(id)})||null;st.resultPage=1;draw()}
function drawHead(){var i=st.item,s=script(),t=document.getElementById('selectedType');document.getElementById('selectedTitle').textContent=i?i.name:'Select a script';document.getElementById('selectedPath').textContent=i?(i.path||'Shared'):'Choose a script from the library to run or inspect it.';t.textContent=s?s.filetype.toUpperCase():i?'Folder':'';t.classList.toggle('hidden',!i);document.getElementById('renameBtn').disabled=!i||i.path==='Shared';document.getElementById('editBtn').disabled=!s;document.getElementById('deleteBtn').disabled=!i||i.path==='Shared';document.getElementById('downloadBtn').disabled=!s}
function drawView(){view.classList.toggle('run',st.view==='run');view.classList.toggle('results',st.view==='results');if(st.view==='run')runView();if(st.view==='results')resultsView();if(st.view==='schedules')schedulesView();if(st.view==='variables')variablesView()}
function filtered(){var q=st.search.toLowerCase();return ns().filter(function(n){var m=ms()[n.meshid],text=((n.name||'')+' '+(m?m.name:'')+' '+((n.tags||[]).join(' '))).toLowerCase();return(!q||text.indexOf(q)>=0)&&(!st.mesh||n.meshid===st.mesh)&&(!st.online||((n.conn||0)&1)!==0)})}function refocus(id,pos){if(!id)return;var x=document.getElementById(id);if(!x)return;x.focus();if(typeof pos==='number'&&x.setSelectionRange)x.setSelectionRange(pos,pos)}
function runView(focusId,caret){if((st.data.permissions||{}).run===false){view.innerHTML='<div class="empty">You do not have permission to run scripts.</div>';return}var list=filtered(),opts='<option value="">All device groups</option>';Object.keys(ms()).forEach(function(id){var m=ms()[id];if(m&&m.mtype===2)opts+='<option value="'+e(id)+'" '+(st.mesh===id?'selected':'')+'>'+e(m.name)+'</option>'});var rows=list.map(function(n){var on=((n.conn||0)&1)!==0,m=ms()[n.meshid];return'<label class="device"><input type="checkbox" value="'+e(n._id)+'" '+(st.nodeIds.has(n._id)?'checked':'')+' onchange="toggleNode(this)"><span><b>'+e(n.name)+'</b><small>'+e(m?m.name:'Unknown group')+(n.tags&&n.tags.length?' · '+e(n.tags.join(', ')):'')+'</small></span><span class="muted"><i class="dot '+(on?'online':'')+'"></i>'+(on?'Online':'Offline')+'</span></label>'}).join('');view.innerHTML='<div class="split"><div class="devicebox"><div class="devicecontrols"><input id="deviceSearch" class="search" placeholder="Search devices" value="'+e(st.search)+'" oninput="st.search=this.value;runView(\'deviceSearch\',this.selectionStart)"><select aria-label="Device group" onchange="st.mesh=this.value;runView()">'+opts+'</select><label><input type="checkbox" '+(st.online?'checked':'')+' onchange="st.online=this.checked;runView()"> Online only</label><label><input type="checkbox" onchange="selectVisible(this.checked)"> Select visible</label><span class="count">'+list.length+' devices</span></div><div class="devicelist">'+(rows||'<div class="empty">No matching devices.</div>')+'</div></div><aside class="summary"><h3>Deployment</h3><strong>'+st.nodeIds.size+'</strong><p>device'+(st.nodeIds.size===1?'':'s')+' selected</p><button class="primary" style="width:100%;margin-bottom:8px" onclick="runNow()" '+(!script()||!st.nodeIds.size?'disabled':'')+'>Run now</button><button style="width:100%" onclick="schedule()" '+(!script()||!st.nodeIds.size?'disabled':'')+'>Schedule</button><p>Only devices where you have remote-command and terminal rights accept jobs.</p></aside></div>';refocus(focusId,caret)}function toggleNode(x){x.checked?st.nodeIds.add(x.value):st.nodeIds.delete(x.value);runView()}function selectVisible(y){filtered().forEach(function(n){y?st.nodeIds.add(n._id):st.nodeIds.delete(n._id)});runView()}function runNow(){if(script()&&st.nodeIds.size)send('runScript',{scriptId:script()._id,nodes:Array.from(st.nodeIds)})}
function status(r){if(r.errorVal!=null)return'Error';if(r.returnVal!=null)return'Completed';if(r.dispatchTime!=null)return'Running';if(r.dontQueueUntil&&r.dontQueueUntil>Date.now()/1000)return'Scheduled';return'Queued'}function format(v){try{return JSON.stringify(JSON.parse(v),null,2)}catch(x){return String(v)}}function resultTime(r){return Number(r.completeTime||r.dispatchTime||r.queueTime||0)}function resultPreview(v){if(v==null||v==='')return'No output';try{var x=JSON.parse(v);if(x&&typeof x==='object'&&x.Result!=null)return String(x.Result)}catch(z){}var t=String(v).replace(/\s+/g,' ').trim();return t.length>80?t.slice(0,77)+'…':t}
function resultsView(focusId,caret){var s=script();if(!s){view.innerHTML='<div class="empty">Select a script to view its results.</div>';return}var q=st.resultSearch||'',f=st.resultStatus||'',rows=(st.data.history||[]).filter(function(r){return String(r.scriptId)===String(s._id)&&(!f||status(r)===f)&&(!q||((nodeName(r.node)+' '+(r.scriptName||'')+' '+(r.returnVal||'')+' '+(r.errorVal||'')).toLowerCase().indexOf(q.toLowerCase())>=0))}).sort(function(a,b){return resultTime(b)-resultTime(a)}),pages=Math.max(1,Math.ceil(rows.length/st.resultPageSize));st.resultPage=Math.min(Math.max(1,st.resultPage),pages);var start=(st.resultPage-1)*st.resultPageSize,pageRows=rows.slice(start,start+st.resultPageSize),body=pageRows.map(function(r){var z=status(r),time=resultTime(r),out=r.errorVal!=null?r.errorVal:r.returnVal,output=out==null||out===''?'—':'<details class="resultdetails"><summary>'+e(resultPreview(out))+'</summary><pre class="output">'+e(format(out))+'</pre></details>';return'<tr><td>'+e(time?new Date(time*1000).toLocaleString():'—')+'</td><td>'+e(nodeName(r.node))+'</td><td>'+e(r.scriptName||scriptName(r.scriptId))+'</td><td><span class="status '+z.toLowerCase()+'">'+z+'</span></td><td>'+output+'</td></tr>'}).join('');view.innerHTML='<div class="filters"><input id="resultSearch" class="search" placeholder="Search results" value="'+e(q)+'" oninput="st.resultSearch=this.value;st.resultPage=1;resultsView(\'resultSearch\',this.selectionStart)"><select onchange="st.resultStatus=this.value;st.resultPage=1;resultsView()"><option value="">All statuses</option>'+['Completed','Error','Running','Queued','Scheduled'].map(function(x){return'<option '+(f===x?'selected':'')+'>'+x+'</option>'}).join('')+'</select><button onclick="csv()">Export CSV</button><span class="muted">'+rows.length+' results for '+e(s.name)+'</span><span class="spacer"></span><div class="pager"><select aria-label="Results per page" onchange="st.resultPageSize=Number(this.value);st.resultPage=1;resultsView()">'+[25,50,100].map(function(x){return'<option value="'+x+'" '+(st.resultPageSize===x?'selected':'')+'>'+x+' / page</option>'}).join('')+'</select><button onclick="st.resultPage--;resultsView()" '+(st.resultPage<=1?'disabled':'')+'>Previous</button><span>Page '+st.resultPage+' of '+pages+'</span><button onclick="st.resultPage++;resultsView()" '+(st.resultPage>=pages?'disabled':'')+'>Next</button></div></div><div class="tablewrap"><table><thead><tr><th>Time</th><th>Device</th><th>Script</th><th>Status</th><th>Output</th></tr></thead><tbody>'+(body||'<tr><td colspan="5" class="empty">No results match this view.</td></tr>')+'</tbody></table></div>';refocus(focusId,caret)}function csv(){var s=script();if(!s)return;location.href='pluginadmin.ashx?pin=scripttask&user=1&report=csv&scriptId='+encodeURIComponent(s._id)}
function recur(s){if(s.recur==='once')return'Once';var x='Every '+s.interval+' '+({minutes:'minute',hourly:'hour',daily:'day',weekly:'week'}[s.recur]||s.recur);return x+(Number(s.interval)===1?'':'s')}function schedulesView(){var s=script(),rows=(st.data.schedules||[]).filter(function(x){return!s||String(x.scriptId)===String(s._id)}),body=rows.map(function(x){return'<tr><td>'+e(scriptName(x.scriptId))+'</td><td>'+e(nodeName(x.node))+'</td><td>'+e(recur(x))+'</td><td>'+e(new Date(x.startAt*1000).toLocaleString())+'</td><td>'+e(x.nextRun?new Date(x.nextRun*1000).toLocaleString():'Pending')+'</td><td>'+e(x.scheduledBy||'')+'</td><td><button class="danger" onclick="delSchedule(\''+e(x._id)+'\')">Delete</button></td></tr>'}).join('');view.innerHTML='<div class="filters"><span class="muted">'+rows.length+' schedules'+(s?' for '+e(s.name):'')+'</span></div><div style="overflow:auto"><table><thead><tr><th>Script</th><th>Device</th><th>Recurrence</th><th>Starts</th><th>Next run</th><th>Created by</th><th></th></tr></thead><tbody>'+(body||'<tr><td colspan="7" class="empty">No schedules found.</td></tr>')+'</tbody></table></div>'}
function target(v){if(v.scope==='global')return'All devices';if(v.scope==='script')return scriptName(v.scopeTarget);if(v.scope==='mesh')return ms()[v.scopeTarget]?ms()[v.scopeTarget].name:v.scopeTarget;if(v.scope==='node')return nodeName(v.scopeTarget);return''}function variablesView(){var can=(st.data.permissions||{}).variables!==false,body=(st.data.variables||[]).map(function(v){return'<tr><td><b>#'+e(v.name)+'#</b></td><td>'+e(v.value)+'</td><td>'+e(v.scope)+'</td><td>'+e(target(v))+'</td><td class="actions">'+(can?'<button onclick="variable(\''+e(v._id)+'\')">Edit</button> <button class="danger" onclick="delVariable(\''+e(v._id)+'\')">Delete</button>':'')+'</td></tr>'}).join('');view.innerHTML='<div class="filters">'+(can?'<button class="primary" onclick="variable()">New variable</button>':'')+'<span class="muted">Variables are substituted as #NAME# immediately before execution.</span></div><div style="overflow:auto"><table><thead><tr><th>Name</th><th>Value</th><th>Scope</th><th>Target</th><th></th></tr></thead><tbody>'+(body||'<tr><td colspan="5" class="empty">No variables configured.</td></tr>')+'</tbody></table></div>'}
function modal(title,body,label,fn){modalTitle.textContent=title;modalBody.innerHTML=body;modalFoot.innerHTML='<button onclick="closeModal()">Cancel</button>'+(label?'<button class="primary" id="modalSave">'+e(label)+'</button>':'');modalBack.classList.add('open');if(label)modalSave.onclick=fn;setTimeout(function(){var x=document.querySelector('#modalBody input,#modalBody textarea,#modalBody select');if(x)x.focus()},0)}function closeModal(){modalBack.classList.remove('open')}function folderId(){if(!st.item)return null;if(st.item.type==='folder')return st.item._id;var f=st.data.tree.find(function(x){return x.type==='folder'&&x.path===st.item.path});return f?f._id:null}
function newScript(){modal('New script','<div class="grid2"><div class="field"><label>Name</label><input id="newName" placeholder="check-tpm.ps1"></div><div class="field"><label>Type</label><select id="newType"><option value="ps1">PowerShell</option><option value="bat">Windows BAT</option><option value="bash">Bash</option></select></div></div>','Create',function(){send('new',{name:newName.value,filetype:newType.value,parent_id:folderId()})})}function newFolder(){modal('New folder','<div class="field"><label>Name</label><input id="newName" placeholder="Compliance"></div>','Create',function(){send('newFolder',{name:newName.value,parent_id:folderId()})})}function renameItem(){if(st.item)modal('Rename','<div class="field"><label>Name</label><input id="renameName" value="'+e(st.item.name)+'"></div>','Save',function(){send('rename',{id:st.item._id,name:renameName.value})})}function editScript(){if(script())send('getScriptContent',{scriptId:script()._id})}function editor(s){modal('Edit script','<div class="grid2"><div class="field"><label>Name</label><input id="editName" value="'+e(s.name)+'"></div><div class="field"><label>Type</label><input value="'+e(String(s.filetype).toUpperCase())+'" disabled></div></div><div class="field"><label>Script</label><textarea id="editContent" spellcheck="false"></textarea></div>','Save',function(){send('editScript',{scriptId:s._id,scriptName:editName.value,scriptContent:editContent.value})});editContent.value=s.content||''}function deleteItem(){if(st.item){var i=st.item;modal('Delete '+i.name,'<p>This permanently deletes the selected '+e(i.type)+'.</p>','Delete',function(){send('delete',{id:i._id})})}}function downloadScript(){if(script())location.href='pluginadmin.ashx?pin=scripttask&user=1&dl='+encodeURIComponent(script()._id)}function delSchedule(id){modal('Delete schedule','<p>Delete this schedule and its pending runs?</p>','Delete',function(){send('deleteSchedule',{id:id})})}
function local(d){return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16)}function schedule(){modal('Schedule on '+st.nodeIds.size+' devices','<div class="grid2"><div class="field"><label>Recurrence</label><select id="schedRecur" onchange="schedFields()"><option value="once">Once</option><option value="minutes">Minutes</option><option value="hourly">Hourly</option><option value="daily">Daily</option><option value="weekly">Weekly</option></select></div><div class="field"><label>Starts</label><input id="schedStart" type="datetime-local" value="'+local(new Date(Date.now()+60000))+'"></div></div><div id="repeatFields" class="hidden"><div class="grid2"><div class="field"><label>Every</label><input id="schedInterval" type="number" min="1" value="1"></div><div class="field"><label>Ends (optional)</label><input id="schedEnd" type="datetime-local"></div></div></div><div id="weekFields" class="field hidden"><label>Weekdays</label><div class="checks">'+['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(function(x,i){return'<label><input type="checkbox" name="weekday" value="'+i+'"> '+x+'</label>'}).join('')+'</div></div>','Create schedule',saveSchedule)}function schedFields(){var r=schedRecur.value;repeatFields.classList.toggle('hidden',r==='once');weekFields.classList.toggle('hidden',r!=='weekly')}function saveSchedule(){var a=Date.parse(schedStart.value),end=schedEnd?Date.parse(schedEnd.value):NaN,days=Array.from(document.querySelectorAll('[name=weekday]:checked')).map(function(x){return Number(x.value)});send('addScheduledJob',{scriptId:script()._id,nodes:Array.from(st.nodeIds),schedule:{recur:schedRecur.value,interval:schedInterval?Number(schedInterval.value):1,startAt:Math.floor(a/1000),endAt:Number.isFinite(end)?Math.floor(end/1000):null,dayVals:days}})}
function targetOptions(scope,selected){var a=[];if(scope==='script')a=st.data.tree.filter(function(x){return x.type==='script'}).map(function(x){return{id:x._id,name:x.name}});if(scope==='mesh')a=Object.keys(ms()).filter(function(id){return ms()[id].mtype===2}).map(function(id){return{id:id,name:ms()[id].name}});if(scope==='node')a=ns().map(function(x){return{id:x._id,name:x.name}});return a.map(function(x){return'<option value="'+e(x.id)+'" '+(String(selected)===String(x.id)?'selected':'')+'>'+e(x.name)+'</option>'}).join('')}function variable(id){var v=(st.data.variables||[]).find(function(x){return String(x._id)===String(id)})||{scope:'global'};modal(id?'Edit variable':'New variable','<div class="grid2"><div class="field"><label>Name</label><input id="varName" value="'+e(v.name||'')+'"></div><div class="field"><label>Scope</label><select id="varScope" onchange="variableTarget()">'+['global','script','mesh','node'].map(function(x){return'<option '+(v.scope===x?'selected':'')+'>'+x+'</option>'}).join('')+'</select></div></div><div class="field" id="varTargetField"><label>Target</label><select id="varTarget"></select></div><div class="field"><label>Value</label><input id="varValue" value="'+e(v.value||'')+'"></div>','Save',function(){send(id?'editVar':'newVar',{id:id,name:varName.value,scope:varScope.value,scopeTarget:varTarget.value||null,value:varValue.value})});varTargetField.dataset.selected=v.scopeTarget||'';variableTarget()}function variableTarget(){var s=varScope.value,x=varTargetField.dataset.selected;varTargetField.classList.toggle('hidden',s==='global');varTarget.innerHTML=targetOptions(s,x);varTargetField.dataset.selected=''}function delVariable(id){modal('Delete variable','<p>Delete this variable?</p>','Delete',function(){send('deleteVar',{id:id})})}
uploadInput.addEventListener('change',function(){var path=st.item?st.item.path:'Shared';Array.from(this.files||[]).forEach(function(f){var r=new FileReader();r.onload=function(){var t=f.name.split('.').pop().toLowerCase();if(t==='sh')t='bash';send('addScript',{name:f.name,content:String(r.result||''),path:path,filetype:t})};r.readAsText(f)});this.value=''});document.addEventListener('keydown',function(x){if(x.key==='Escape')closeModal()});watchTheme();refresh();setInterval(function(){if(!document.hidden)refresh()},15000);
</script></body></html>
